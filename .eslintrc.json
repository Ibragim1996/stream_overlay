{
  "extends": ["next/core-web-vitals"],
  "rules": {
    "no-restricted-syntax": [
      "error",
      {
        "selector": "CallExpression[callee.object.name='process'][callee.property.name='env'] > MemberExpression[property.name=/^(?!NEXT_PUBLIC_)/]",
        "message": "Only NEXT_PUBLIC_ environment variables are allowed in client components. Use server-side code for secrets."
      }
    ]
  },
  "overrides": [
    {
      "files": ["app/**/*.tsx", "app/**/*.ts"],
      "rules": {
        "no-restricted-syntax": [
          "error",
          {
            "selector": "CallExpression[callee.object.name='process'][callee.property.name='env'] > MemberExpression[property.name=/^(?!NEXT_PUBLIC_)/]",
            "message": "SECURITY: Only NEXT_PUBLIC_ environment variables allowed in client components. Secrets must be used server-side only."
          }
        ]
      }
    }
  ]
}